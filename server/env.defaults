# ─────────────────────────────────────────────────────────────────────────────
# server/ — non-secret environment defaults
# Safe to commit. Merged with .secrets by harness/env_gen.sh.
# ─────────────────────────────────────────────────────────────────────────────

# Set to true to allow unauthenticated guest access (free-tier limits apply)
DEMO_MODE=false

# Allowed CORS origins — comma-separated or * for open access
FRONTEND_URL=*

# Path for the append-only audit log
AUDIT_LOG_PATH=audit.jsonl

# Uvicorn port (hosts override this with $PORT)
PORT=8000

# Hosted Grimoire endpoint for the fetch_grimoire tool.
# When set, tools.py fetches gists from {GRIMOIRE_URL}/gist/{filename}.
# Falls back to the local gist directory when unset or unreachable.
# Example: GRIMOIRE_URL=https://grimoire.joinrabble.world
GRIMOIRE_URL=

# ── Beam: RaBbLE-Pocket's voice link (server/beam.py) ─────────────────────────
# Speech-to-text, the reply LLM and text-to-speech all go through Groq
# (GROQ_API_KEY). The device token itself is a secret: BEAM_DEVICE_TOKEN in
# .secrets. BEAM_ALLOW_GUEST=true opens the beam without a token: LAN dev only.
BEAM_ALLOW_GUEST=false
BEAM_LLM_CHAIN=groq:openai/gpt-oss-20b,groq:openai/gpt-oss-120b
BEAM_REASONING_EFFORT=low
BEAM_STT_MODEL=whisper-large-v3-turbo
BEAM_TTS_MODEL=canopylabs/orpheus-v1-english
BEAM_TTS_VOICE=daniel
BEAM_TTS_VOICES=daniel,austin,troy
BEAM_HISTORY_TURNS=8

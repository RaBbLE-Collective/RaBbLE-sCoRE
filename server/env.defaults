# ─────────────────────────────────────────────────────────────────────────────
# server/ — non-secret environment defaults
# Safe to commit. Merged with .secrets by harness/env_gen.sh.
# ─────────────────────────────────────────────────────────────────────────────

# Set to true to allow unauthenticated guest access (free-tier limits apply)
DEMO_MODE=false

# DEMO_MODE guests are loopback-only unless this is also true. Only the public
# cloud demo sets it; a laptop never does. It also keeps the open FRONTEND_URL CORS below.
DEMO_MODE_PUBLIC=false

# Allowed CORS origins for the public cloud demo (DEMO_MODE_PUBLIC=true) — comma-separated or *
FRONTEND_URL=*

# CORS origins for every other instance (comma-separated; default none = no cross-origin
# pages). When set, it wins over FRONTEND_URL on cloud too. "*" never gets credentials.
CORS_ORIGINS=

# /docs, /redoc and /openapi.json: off (they map every route). true only on a laptop.
API_DOCS=false

# POST /api/v1/auth/register is open to anyone and returns an API key: off unless true
ALLOW_REGISTER=false

# Comma-separated user ids that may reach CLI providers (claude_code, codex, ...), besides
# the beam device identity ("pocket") which always may. Default empty = nobody else.
CLI_ALLOWED_SUBS=

# Path for the append-only audit log. Empty = DATA_DIR/audit.jsonl (the admin export includes only that one)
AUDIT_LOG_PATH=

# Uvicorn port (hosts override this with $PORT)
PORT=8000

# Hosted Grimoire endpoint for the fetch_grimoire tool.
# When set, tools.py fetches gists from {GRIMOIRE_URL}/gist/{filename}.
# Falls back to the local gist directory when unset or unreachable.
# Example: GRIMOIRE_URL=https://grimoire.joinrabble.world
GRIMOIRE_URL=

# ── Beam: RaBbLE-Pocket's voice link (server/beam.py) ─────────────────────────
# Speech-to-text, the reply LLM and text-to-speech all go through Groq
# (GROQ_API_KEY). The device token itself is a secret: BEAM_DEVICE_TOKEN in
# .secrets. BEAM_ALLOW_GUEST=true opens the beam without a token: LAN dev only.
BEAM_ALLOW_GUEST=false
BEAM_LLM_CHAIN=groq:openai/gpt-oss-20b,groq:openai/gpt-oss-120b
BEAM_REASONING_EFFORT=low
BEAM_STT_MODEL=whisper-large-v3-turbo
BEAM_TTS_MODEL=canopylabs/orpheus-v1-english
BEAM_TTS_VOICE=daniel
BEAM_TTS_VOICES=daniel,austin,troy
BEAM_HISTORY_TURNS=8
# Seconds the cloud waits for a linked laptop node before cancelling the turn and falling back
BEAM_NODE_DEADLINE_S=25

# ── Claude Code bridge (optional) ───────────────────────────────────────────
# Keep Groq configured above for Pocket speech-to-text and text-to-speech. To
# send Pocket turns to Claude Code, override BEAM_LLM_CHAIN in server/.env:
#   BEAM_LLM_CHAIN=claude_code:claude-sonnet-4-6
# Set CC_WORKDIR to the Collective root so Claude can use the Grimoire and
# RaBbLE-OS context. CC_COMMAND also accepts an argv-style container wrapper:
#   CC_COMMAND=podman exec -i rabble-claude claude
CC_COMMAND=claude
CC_WORKDIR=
# A headless Beam cannot answer an interactive Claude Code permission prompt.
# For a local Pocket bridge, allow research tools without granting shell or
# write access: CC_ALLOWED_TOOLS=WebSearch,WebFetch
CC_ALLOWED_TOOLS=

# ── Laptop node link (server/node.py cloud side, server/node_client.py laptop side) ──
# The node dials out to /api/v1/node; the secret is SCORE_NODE_SECRET in .secrets (>= 32 chars,
# on both sides). Laptop side only:
#   SCORE_NODE_URL=wss://<cloud host>/api/v1/node   (ws:// only for loopback)
#   SCORE_NODE_ID=<name in logs, default hostname>
# CC_CONTEXT_DIR is REQUIRED for the node: an existing curated, secret-free directory outside
# any git work tree (CC_WORKDIR is never used by the node). CC_TOOLS = built-in tools Claude
# may have; CC_MODEL pins the model.
CC_CONTEXT_DIR=
CC_TOOLS=WebSearch,WebFetch

# ── Hosted persistence: R2 snapshots, transcripts, request budgets (server/storage.py) ──
# Render's free disk is wiped on every deploy. With R2 set, the sqlite db (users, invites,
# guest counts) is restored from a snapshot at boot and re-uploaded after writes (every ~30 s,
# only if changed, and once on shutdown). If the boot restore fails for any reason but a 404, the
# server serves from a local db with uploads OFF and retries the restore every
# SNAPSHOT_RESTORE_RETRY_S (300). Nothing may ever silently run empty: finding no snapshot is NOT
# a fresh start (a wrong R2_PREFIX/R2_BUCKET or token scope looks identical). FIRST BOOT, once:
# set R2_ALLOW_FRESH_START=1 (and unset it after); it is honoured only if the bucket holds no
# snapshot-looking object anywhere and snapshots/INITIALIZED (written after the first upload)
# does not exist. Snapshots are never overwritten: snapshots/score-<UTC stamp>.db plus a
# snapshots/latest.json pointer; the newest SNAPSHOT_KEEP (8) are kept. Each is integrity-checked
# before upload and after download (older ones are tried if the newest is bad), and an upload is
# refused while the local db has >10% fewer users or invites than the last snapshot, until
# SNAPSHOT_ALLOW_SHRINK=1 (a deliberate admin act). Status: /api/v1/admin/inventory r2.snapshots.
# Unset after use: R2_ALLOW_FRESH_START, SNAPSHOT_ALLOW_SHRINK. SECURITY: the snapshot and the
# admin export hold every account (API keys stored as sha256, BYO keys Fernet-encrypted under
# JWT_SECRET) and nothing in R2 is public: treat the bucket, its token and the export as secrets.
# All R2_* unset = local-only: everything still works,
# nothing leaves the box. The access key and secret are secrets (.secrets / Render env).
#   R2_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
#   R2_ACCESS_KEY_ID=...        R2_SECRET_ACCESS_KEY=...
#   R2_BUCKET=<a dedicated bucket, never the firmware one>
R2_PREFIX=score/
# Per-month request budgets, set under R2's free tiers (1M Class A, 10M Class B). At a budget
# all R2 I/O stops (local disk only), new guests get 503, and it resumes next UTC month.
R2_CLASS_A_BUDGET=800000
R2_CLASS_B_BUDGET=8000000
# file: /chat transcripts go to DATA_DIR/transcripts/YYYY-MM-DD.jsonl. r2: one object per
# conversation (transcripts/YYYY-MM-DD/<session>.json), file when R2 is unset, over budget or down.
TRANSCRIPT_BACKEND=file

# ── Per-device guests (POST /api/v1/users/guest) ─────────────────────────────
# GUEST_ISSUE_SECRET (secret) is what a device sends as X-Guest-Secret to get a guest account;
# unset = the endpoint is off (404). All guests share GUEST_DAILY_TURNS model turns per UTC day
# across the beam and /chat; over it they get 429.
GUEST_DAILY_TURNS=400
# One guest's own cap per UTC day (so one device cannot drain the shared pool), and a global cap
# on guest accounts issued per hour (429 over it). Both counted in the db.
GUEST_PER_GUEST_DAILY_TURNS=100
GUEST_ISSUE_PER_HOUR=30
# Guests are also refused while ANY Groq rate-limit window (read from Groq's x-ratelimit-* response
# headers on chat, speech-to-text and text-to-speech calls) is more than this fraction used, so
# members and the owner keep the rest. No header data yet (cold start): only the pools above apply.
GUEST_GROQ_CUTOFF=0.5

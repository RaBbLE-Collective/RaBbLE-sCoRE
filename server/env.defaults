# ─────────────────────────────────────────────────────────────────────────────
# server/ — non-secret environment defaults
# Safe to commit. Merged with .secrets by harness/env_gen.sh.
# ─────────────────────────────────────────────────────────────────────────────

# Set to true to allow unauthenticated guest access (free-tier limits apply)
DEMO_MODE=false

# DEMO_MODE guests are loopback-only unless this is also true. Only the public
# cloud demo sets it; a laptop never does. It also keeps the open FRONTEND_URL CORS below.
DEMO_MODE_PUBLIC=false

# Allowed CORS origins for the public cloud demo (DEMO_MODE_PUBLIC=true) — comma-separated or *
FRONTEND_URL=*

# CORS origins for every other instance (comma-separated; default none = no cross-origin
# pages). When set, it wins over FRONTEND_URL on cloud too. "*" never gets credentials.
CORS_ORIGINS=

# POST /api/v1/auth/register is open to anyone and returns an API key: off unless true
ALLOW_REGISTER=false

# Comma-separated user ids that may reach CLI providers (claude_code, codex, ...), besides
# the beam device identity ("pocket") which always may. Default empty = nobody else.
CLI_ALLOWED_SUBS=

# Path for the append-only audit log
AUDIT_LOG_PATH=audit.jsonl

# Uvicorn port (hosts override this with $PORT)
PORT=8000

# Hosted Grimoire endpoint for the fetch_grimoire tool.
# When set, tools.py fetches gists from {GRIMOIRE_URL}/gist/{filename}.
# Falls back to the local gist directory when unset or unreachable.
# Example: GRIMOIRE_URL=https://grimoire.joinrabble.world
GRIMOIRE_URL=

# ── Beam: RaBbLE-Pocket's voice link (server/beam.py) ─────────────────────────
# Speech-to-text, the reply LLM and text-to-speech all go through Groq
# (GROQ_API_KEY). The device token itself is a secret: BEAM_DEVICE_TOKEN in
# .secrets. BEAM_ALLOW_GUEST=true opens the beam without a token: LAN dev only.
BEAM_ALLOW_GUEST=false
BEAM_LLM_CHAIN=groq:openai/gpt-oss-20b,groq:openai/gpt-oss-120b
BEAM_REASONING_EFFORT=low
BEAM_STT_MODEL=whisper-large-v3-turbo
BEAM_TTS_MODEL=canopylabs/orpheus-v1-english
BEAM_TTS_VOICE=daniel
BEAM_TTS_VOICES=daniel,austin,troy
BEAM_HISTORY_TURNS=8
# Seconds the cloud waits for a linked laptop node before cancelling the turn and falling back
BEAM_NODE_DEADLINE_S=25

# ── Claude Code bridge (optional) ───────────────────────────────────────────
# Keep Groq configured above for Pocket speech-to-text and text-to-speech. To
# send Pocket turns to Claude Code, override BEAM_LLM_CHAIN in server/.env:
#   BEAM_LLM_CHAIN=claude_code:claude-sonnet-4-6
# Set CC_WORKDIR to the Collective root so Claude can use the Grimoire and
# RaBbLE-OS context. CC_COMMAND also accepts an argv-style container wrapper:
#   CC_COMMAND=podman exec -i rabble-claude claude
CC_COMMAND=claude
CC_WORKDIR=
# A headless Beam cannot answer an interactive Claude Code permission prompt.
# For a local Pocket bridge, allow research tools without granting shell or
# write access: CC_ALLOWED_TOOLS=WebSearch,WebFetch
CC_ALLOWED_TOOLS=

# ── Laptop node link (server/node.py cloud side, server/node_client.py laptop side) ──
# The node dials out to /api/v1/node; the secret is SCORE_NODE_SECRET in .secrets (>= 32 chars,
# on both sides). Laptop side only:
#   SCORE_NODE_URL=wss://<cloud host>/api/v1/node   (ws:// only for loopback)
#   SCORE_NODE_ID=<name in logs, default hostname>
# CC_CONTEXT_DIR is REQUIRED for the node: an existing curated, secret-free directory outside
# any git work tree (CC_WORKDIR is never used by the node). CC_TOOLS = built-in tools Claude
# may have; CC_MODEL pins the model.
CC_CONTEXT_DIR=
CC_TOOLS=WebSearch,WebFetch

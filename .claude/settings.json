{
  "permissions": {
    "allow": [
      "Read(*)"
    ],
    "deny": [
      "Bash(*)",
      "WebSearch(*)",
      "WebFetch(*)",
      "Agent(*)"
    ]
  },
  "env": {},
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[sCoRE] Bash blocked — write a task file to tasks/pending/ instead' >&2 && exit 1"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[sCoRE] Agent tool blocked — write a task file to tasks/pending/ instead' >&2 && exit 1"
          }
        ]
      }
    ],
    "PostToolUse": [],
    "Notification": [],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/session-start.sh --summarize 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}

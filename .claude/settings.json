{
  "permissions": {
    "allow": [],
    "deny": [
      "Bash(*)",
      "WebSearch(*)",
      "WebFetch(*)"
    ]
  },
  "env": {},
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[sCoRE] Bash blocked — delegate to rabble-execution' >&2 && exit 1"
          }
        ]
      }
    ],
    "PostToolUse": [],
    "Notification": [],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/session-start.sh --summarize 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
